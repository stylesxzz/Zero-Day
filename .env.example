# Copy to .env locally. Never commit credentials or RPC URLs containing secrets.
# OpenAI-compatible AI endpoint (single default profile)
# For multiple profiles, set ZERO_DAY_AI_PROVIDERS_JSON to a JSON array with id, name, base_url, model, api_key_env.
ZERO_DAY_AI_PROVIDERS_JSON=
ZERO_DAY_AI_BASE_URL=https://api.openai.com/v1
ZERO_DAY_AI_API_KEY=
ZERO_DAY_AI_MODEL=

# Exchange private API is only used for read-only balance queries in this release.
ZERO_DAY_EXCHANGE_ID=kraken
ZERO_DAY_EXCHANGE_API_KEY=
ZERO_DAY_EXCHANGE_SECRET=

# Public EVM JSON-RPC endpoints for native balance reads only
ZERO_DAY_RPC_ETHEREUM=
ZERO_DAY_RPC_BASE=
ZERO_DAY_RPC_POLYGON=
ZERO_DAY_RPC_ARBITRUM=
ZERO_DAY_RPC_OPTIMISM=
ZERO_DAY_RPC_BSC=

# Local persistent database
ZERO_DAY_DB_PATH=data/zeroday.db

# Live execution is intentionally not configurable through env in this release.
ZERO_DAY_LIVE_TRADING=false
