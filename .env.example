# Copy to .env locally. NEVER commit real credentials.
ZERO_DAY_AI_BASE_URL=https://api.openai.com/v1
ZERO_DAY_AI_API_KEY=
ZERO_DAY_AI_MODEL=

ZERO_DAY_EXCHANGE_ID=kraken
ZERO_DAY_EXCHANGE_API_KEY=
ZERO_DAY_EXCHANGE_SECRET=

# Live orders are OFF unless both flags are deliberately enabled.
ZERO_DAY_LIVE_TRADING=false
ZERO_DAY_LIVE_ACK=
ZERO_DAY_MAX_ORDER_QUOTE=10
ZERO_DAY_ALLOWED_SYMBOLS=BTC/USDT
ZERO_DAY_MAX_DAILY_LOSS_QUOTE=25
ZERO_DAY_MAX_OPEN_POSITIONS=3
